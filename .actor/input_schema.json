{
  "title": "Naukri Scraper Input",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "maxResults": {
      "title": "Maximum Results",
      "type": "integer",
      "description": "Maximum number of job listings to scrape",
      "default": 100,
      "minimum": 1,
      "maximum": 10000
    },
    "keywords": {
      "title": "Job Keywords",
      "type": "string",
      "description": "Search keywords (e.g., 'python developer', 'data scientist')",
      "editor": "textfield"
    },
    "location": {
      "title": "Location",
      "type": "string",
      "description": "Job location (e.g., 'bangalore', 'mumbai', 'india')",
      "default": "india",
      "editor": "textfield"
    },
    "experience": {
      "title": "Experience Level",
      "type": "string",
      "description": "Experience level filter (e.g., '0-2', '2-5', '5-10')",
      "editor": "textfield"
    },
    "proxyConfiguration": {
      "title": "Proxy Configuration",
      "type": "object",
      "description": "Proxy settings for the scraper",
      "editor": "proxy",
      "default": {
        "useApifyProxy": true,
        "apifyProxyGroups": ["RESIDENTIAL"]
      }
    }
  },
  "required": ["maxResults"]
}

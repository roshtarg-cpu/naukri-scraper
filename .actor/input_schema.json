{
  "title": "Naukri Scraper Input",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "searchQuery": {
      "title": "Search Query",
      "type": "string",
      "description": "Job title or keywords (e.g., 'python developer', 'data scientist')",
      "editor": "textfield",
      "prefill": "python developer"
    },
    "location": {
      "title": "Location",
      "type": "string",
      "description": "Job location (e.g., 'bangalore', 'mumbai', 'india')",
      "editor": "textfield",
      "prefill": "bangalore"
    },
    "experience": {
      "title": "Experience Level",
      "type": "string",
      "description": "Experience level filter (e.g., '0-2', '2-5', '5-10')",
      "editor": "textfield",
      "prefill": "2-5"
    },
    "maxResults": {
      "title": "Maximum Results",
      "type": "integer",
      "description": "Maximum number of job listings to scrape",
      "minimum": 1,
      "maximum": 1000,
      "default": 50,
      "prefill": 10
    },
    "proxyConfiguration": {
      "title": "Proxy Configuration",
      "type": "object",
      "description": "Proxy settings for the scraper",
      "editor": "proxy",
      "prefill": {
        "useApifyProxy": true,
        "apifyProxyGroups": ["RESIDENTIAL"]
      }
    }
  },
  "required": ["maxResults"]
}
